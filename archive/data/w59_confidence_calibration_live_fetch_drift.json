  "objective": "Tune classification confidence against the W58 corpus and prepare for live website drift.",
  "goal": "Reduce false-confident-wrong outcomes, compare deterministic snapshot results against approved live resolver observations, preserve honest uncertainty, and decide what must be confirmed before five-consultant pilot testing.",
  "calibrationPolicy": {
    "recommendedMinimumScore": 0.82,
    "recommendedMinimumEvidenceCitations": 2,
    "recommendedRequiresStableLaneUnderDrift": true,
    "needsConfirmationScoreBand": {
      "minimum": 0.45,
      "maximum": 0.81
    },
    "ambiguousMarginMaximum": 0.25,
    "downgradeToConfirmationWhen": [
      "live observation has fewer than two source URLs",
      "leading lane changed between snapshot and live observation",
      "second candidate is within ambiguousMarginMaximum",
      "live observation has failureState ambiguous",
      "live observation is source-limited but still has partial category evidence"
    ],
    "insufficientEvidenceWhen": [
      "blocked",
      "thin",
      "unavailable",
      "timeout",
      "unsafe URL",
      "no lane candidates"
    ],
    "falseConfidentWrongMaximum": 0,
    "unsupportedClaimsMaximum": 0,
    "driftReviewRequiredWhenLaneChanges": true
  },
