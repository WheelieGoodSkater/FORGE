# Intelligent Demo Builder hosted websiteResolverServiceV1 environment.
# Copy values into a protected shell or secret manager. Do not commit real secrets.

IDB_RESOLVER_HOST=0.0.0.0
IDB_RESOLVER_PORT=8787

# Secret. Required. Set only outside the repo.
IDB_RESOLVER_TOKEN=<set-in-secret-manager>

# Exact origins only. No wildcard.
IDB_RESOLVER_ALLOWED_ORIGINS=https://<approved-netsuite-account>.app.netsuite.com

# Optional safety controls.
IDB_RESOLVER_RATE_TOKEN_PER_MINUTE=12
IDB_RESOLVER_RATE_DOMAIN_PER_MINUTE=6
IDB_RESOLVER_REQUEST_MAX_BYTES=100000
