{
  "schema": "idb.w52-unknown-site-corpus-contract.v1",
  "status": "complete_end_goal_intelligence_harness_ready",
  "objective": "Build the production-shaped intelligence evaluation harness around real and synthetic unknown websites.",
  "goal": "Prove IDB is becoming an intelligence product by testing human-labeled website identification, confidence calibration, false-confident-wrong limits, unsupported-claim blockers, and trace evidence coverage.",
  "consumes": {
    "websiteEvidenceSchema": "idb.website-evidence.v1",
    "websiteClassifierSchema": "idb.website-classifier.v1",
    "classifierTrace": "trace_samples/w51_website_classifier_trace_sample.json"
  },
  "evaluationPolicy": {
    "correctOrHonestPassRateMinimum": 0.8,
    "falseConfidentWrongRateMaximum": 0.05,
    "unsupportedClaimsMaximum": 0,
    "traceEvidenceCoverageMinimum": 0.95,
    "confidenceStates": [
      "recommended",
      "needs_confirmation",
      "insufficient_evidence"
    ],
    "correctOrHonestDefinition": [
      "recommended with matching human-labeled lane and supported citations",
      "needs_confirmation when human label allows multiple plausible lanes or marks ambiguous",
      "insufficient_evidence when human label expects blocked thin unavailable or timeout behavior"
    ],
    "falseConfidentWrongDefinition": "classificationState is recommended and laneRecommendation does not match the human-labeled expected lane or accepted alternates",
    "unsupportedClaimDefinition": "recommended lane/proof/product/demand output without a source URL citation or without allowed insufficient/confirmation state"
  },
