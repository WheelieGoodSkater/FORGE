{
  "schema": "idb.w58-real-unknown-site-corpus.v1",
  "status": "complete_real_unknown_site_corpus_ready",
  "objective": "Prove the live resolver and classifier against real consultant-style websites.",
  "goal": "Evaluate human-labeled website identification, confidence calibration, false-confident-wrong limits, unsupported-claim blockers, and trace evidence coverage across real URL seeds and synthetic failure cases.",
  "roles": [
    {
      "name": "Website Intelligence Agent",
      "owns": "Evidence quality, extraction gaps, and page-sampling coverage."
    },
    {
      "name": "Classifier Calibration Agent",
      "owns": "Recommended, needs confirmation, and insufficient evidence thresholds."
    },
    {
      "name": "Pilot Evidence Lead",
      "owns": "Human labels, expected outcomes, evidence checklist, and stop/go scoring."
    },
    {
      "name": "Security Guard",
      "owns": "Blocked domains, unsafe schemes, redirects, timeout safety, and no-write boundaries."
    },
    {
      "name": "Regression Guard Agent",
      "owns": "Validator gates, false-confident-wrong limit, unsupported-claim limit, and no-regression boundaries."
    }
  ],
  "fixturePolicy": {
    "purpose": "Deterministic corpus testing for resolver and classifier behavior before live internet fetch evaluation.",
    "realUrlSeeds": true,
    "snapshotHtmlIsFixture": true,
    "liveWebsiteClaim": false,
    "productionNextStep": "W59 should run authenticated or approved live-fetch collection against the same corpus and compare drift."
  },
  "evaluationPolicy": {
    "correctOrHonestPassRateMinimum": 0.85,
    "falseConfidentWrongRateMaximum": 0,
    "unsupportedClaimsMaximum": 0,
    "traceEvidenceCoverageMinimum": 0.95,
    "minimumCorpusCases": 9,
    "minimumRealUrlSeedCases": 4,
    "confidenceStates": [
      "recommended",
      "needs_confirmation",
      "insufficient_evidence"
    ],
    "correctOrHonestDefinition": [
      "recommended with matching human-labeled lane and source-backed citations",
      "needs_confirmation when labels identify ambiguity or accepted alternates",
      "insufficient_evidence when labels expect blocked thin unavailable timeout or unsafe URL behavior"
    ],
    "falseConfidentWrongDefinition": "classificationState is recommended and the recommended lane does not match the human-labeled expected lane or accepted alternate lane.",
    "unsupportedClaimDefinition": "any recommendation, product seed, product family, demand moment, ROI, or competitive claim without source URL evidence or without an honest uncertainty state."
  },
